<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <!-- Rounded Square Background using Brand Rich Brown -->
  <rect width="512" height="512" rx="112" fill="#4A3728"/>
  
  <!-- Monogram text in Brand Inter Bold White -->
  <text x="50%" y="58%" dominant-baseline="middle" text-anchor="middle" font-family="'Inter', sans-serif" font-weight="900" font-size="240" fill="#FFFFFF">LL</text>
  
  <!-- Accent dot in Brand Deep Orange -->
  <circle cx="390" cy="390" r="36" fill="#E67E22"/>
</svg>
